# Copia este archivo como .env y completá los valores reales.
# NUNCA commitees el .env con credenciales reales.

PORT=5000
DATABASE_PATH=/ruta/absoluta/al/backend/
DATABASE_NAME=grupob.db

# JWT
JWT_SECRET_KEY=cambia-esta-clave-por-una-segura
JWT_ACCESS_TOKEN_EXPIRES=3600

# Mail (SMTP Gmail — usá una App Password, no tu contraseña real)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres
FLASKY_MAIL_SENDER=GOL GYM <tu-email@gmail.com>
